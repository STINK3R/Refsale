FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# psycopg2-binary and onnxruntime ship prebuilt wheels with their own
# libraries: no gcc, libpq-dev or other apt packages needed.
COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt

# The background-removal networks are baked into the image, so nothing is
# fetched from the internet at run time: isnet-general-use (~180 MB, best
# edges, ~800 MB of memory while it works) and u2netp (~5 MB, ~250 MB), used
# when the server has little memory free (app/imaging.py picks per photo).
# Not fatal: without them the site still builds and runs, and photos get a
# simple cut-out of a plain background instead.
ENV U2NET_HOME=/opt/rembg-models
ARG REMBG_MODEL=isnet-general-use
ENV REMBG_MODEL=${REMBG_MODEL}
COPY scripts/fetch_bg_models.py /tmp/fetch_bg_models.py
RUN python /tmp/fetch_bg_models.py \
    || echo "WARNING: background-removal models were not downloaded; the simple cut-out will be used"

# Copy application code
COPY server.py .
COPY app/ ./app/

RUN mkdir -p uploads

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--timeout", "120", "server:app"]
