# Copy to .env and fill in. Never commit the real .env.

# ── Required ───────────────────────────────────────────────
# Signs admin and member tokens. Backend refuses to start without it
# (min 32 chars). Generate:  openssl rand -hex 32
SERVER_SECRET=

# ── Database ───────────────────────────────────────────────
# Must match the password actually set on the postgres role:
#   docker compose exec db psql -U coop -d coop -c "ALTER USER coop WITH PASSWORD '...';"
# Percent-encode special characters inside DATABASE_URL (@ → %40, : → %3A).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://coop:ПАРОЛЬ@db:5432/coop

# ── Domain ─────────────────────────────────────────────────
WEBSITE_URL=https://refsale.ru
SITE_DOMAIN=https://refsale.ru
# Restrict the API to your own origin (default is "*")
CORS_ORIGINS=https://refsale.ru

# ── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=

# ── Telegram bot ───────────────────────────────────────────
# A bot of its own: two stacks polling one token knock each other off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# ── Loopback ports (defaults keep clear of the cooperative's 5000/8080)
# BACKEND_PORT=5001
# ADMINER_PORT=8091

# ── Frontend build args ────────────────────────────────────
# DaData address autocomplete. Ends up in the JS bundle, so it is public by
# nature — restrict it by referrer in the DaData dashboard.
VITE_DADATA_TOKEN=


# ── First install only ─────────────────────────────────────
# Initial admin password. Leave empty to have one generated and printed
# to the backend log on first boot.
ADMIN_PASSWORD=
